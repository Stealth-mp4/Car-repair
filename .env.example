# Copy to .env.local and fill in. `.env*` is gitignored — never commit real values.

# ---- Supabase (required) -----------------------------------------------------
# Project Settings > API Keys. The console will not start without these.
#
# PUBLISHABLE key is safe in the browser — it ships in the page source, and RLS
# decides what it can reach. SECRET key bypasses RLS entirely: server only,
# never in a NEXT_PUBLIC_ var.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# ---- Site --------------------------------------------------------------------
# The origin this site is served from, no trailing slash. Two jobs, both of
# which fail confusingly if it's wrong: where Square sends a customer back after
# paying, and the URL the webhook signature is computed over — which must match
# the subscription character for character.
#
# Local: http://localhost:3000, or the ngrok URL while testing webhooks.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Square checkout ---------------------------------------------------------
# Optional. Without these, promos fall back to the single fixed payment link in
# the console and payments are confirmed by hand — nothing breaks.
#
# All from developer.squareup.com/apps. The token and the signature key are as
# sensitive as SUPABASE_SECRET_KEY and must never be NEXT_PUBLIC_. Sandbox and
# production have their own token AND their own location id; they move together.
SQUARE_ENV=sandbox
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
# Shown on the webhook subscription once created. One per subscription, so a
# tunnel subscription and the live one have different keys.
SQUARE_WEBHOOK_SIGNATURE_KEY=

# ---- Already used by the public site ----------------------------------------
# Destination for quote-form + chat leads (CRM, Zapier, email service).
# Unset: leads are accepted and logged to the server console only.
LEAD_WEBHOOK_URL=

# ---- Not wired yet — see README-admin.md "What the dashboard still needs" ----
# STRIPE_SECRET_KEY=
# RESEND_API_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# GOOGLE_PLACES_API_KEY=
