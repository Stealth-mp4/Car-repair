# Copy to .env.local and fill in. `.env*` is gitignored — never commit real values.

# ---- Admin console login ----------------------------------------------------
# OPTIONAL IN DEVELOPMENT. `npm run dev` falls back to the seeded login in
# lib/admin/auth.ts (admin / iqballaz), so you can leave these blank locally.
#
# REQUIRED IN PRODUCTION. A production build has no seeded login and refuses to
# open the console without all three — hardcoded credentials that ship are how
# admin panels get found, and git history keeps them forever.
#
# Generate the secret with:  openssl rand -base64 32
ADMIN_USER=
ADMIN_PASSWORD=
SESSION_SECRET=

# ---- Already used by the public site ----------------------------------------
# Destination for quote-form + chat leads (CRM, Zapier, email service).
# Unset: leads are accepted and logged to the server console only.
LEAD_WEBHOOK_URL=

# ---- Not wired yet — see README-admin.md "What the dashboard still needs" ----
# DATABASE_URL=
# STRIPE_SECRET_KEY=
# RESEND_API_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# GOOGLE_PLACES_API_KEY=
