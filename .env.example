# Copy to .env.local and fill in. `.env*` is gitignored — never commit real values.

# ---- Supabase (required) -----------------------------------------------------
# Project Settings > API Keys. The console will not start without these.
#
# PUBLISHABLE key is safe in the browser — it ships in the page source, and RLS
# decides what it can reach. SECRET key bypasses RLS entirely: server only,
# never in a NEXT_PUBLIC_ var.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# ---- Already used by the public site ----------------------------------------
# Destination for quote-form + chat leads (CRM, Zapier, email service).
# Unset: leads are accepted and logged to the server console only.
LEAD_WEBHOOK_URL=

# ---- Not wired yet — see README-admin.md "What the dashboard still needs" ----
# STRIPE_SECRET_KEY=
# RESEND_API_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# GOOGLE_PLACES_API_KEY=
