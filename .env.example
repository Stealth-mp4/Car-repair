# Copy to .env.local and fill in. `.env*` is gitignored — never commit real values.

# ---- Admin console login ----------------------------------------------------
# OPTIONAL WHILE DEMOING. The console falls back to the seeded login in
# lib/admin/auth.ts (admin / iqballaz) in every environment, including deployed
# builds, so a demo link works with no setup.
#
# SET THESE BEFORE REAL USE. They override the seed with no code change, which
# is how you retire the shared demo credential when the client's staff take
# over.
#
# Generate the secret with:  openssl rand -base64 32
ADMIN_USER=
ADMIN_PASSWORD=
SESSION_SECRET=

# ---- Already used by the public site ----------------------------------------
# Destination for quote-form + chat leads (CRM, Zapier, email service).
# Unset: leads are accepted and logged to the server console only.
LEAD_WEBHOOK_URL=

# ---- Not wired yet — see README-admin.md "What the dashboard still needs" ----
# DATABASE_URL=
# STRIPE_SECRET_KEY=
# RESEND_API_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# GOOGLE_PLACES_API_KEY=
